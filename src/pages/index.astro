---
import Layout from '../layouts/Layout.astro';
import ExtensionsGrid from '../components/ExtensionsGrid';
---

<Layout
  title="VS Code Extensions by Jakub Kozera"
  description="Free VS Code extensions for .NET developers — C# Dev Tools, MS SQL Manager and more."
>
  <!-- Header / Hero -->
  <header class="bg-gradient-to-br from-slate-900 via-slate-800 to-blue-900 text-white">
    <div class="max-w-5xl mx-auto px-6 py-20 text-center">
      <div class="inline-flex items-center gap-2 bg-blue-500/20 border border-blue-400/30 rounded-full px-4 py-1.5 text-sm text-blue-300 mb-6">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
        All extensions are free & open source
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-5 leading-tight">
        VS Code Extensions<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">
          for .NET Developers
        </span>
      </h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto mb-8">
        A collection of professional VS Code extensions designed to boost productivity across the
        entire .NET development lifecycle — from solution management to database tooling.
      </p>
      <a
        href="#extensions"
        class="inline-flex items-center gap-2 rounded-xl bg-blue-500 hover:bg-blue-400 transition-colors px-6 py-3 text-sm font-semibold shadow-lg shadow-blue-500/30"
      >
        Browse extensions
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width={2}>
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>
  </header>

  <!-- Extensions section -->
  <main id="extensions" class="max-w-5xl mx-auto px-6 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 mb-3">Available Extensions</h2>
      <p class="text-gray-500 max-w-xl mx-auto">
        Each extension is available on both the VS Code Marketplace and Open VSX Registry, so you
        can use them with VS Code, VS Codium, or any compatible editor.
      </p>
    </div>

    <ExtensionsGrid client:load />
  </main>

  <!-- Footer -->
  <footer class="border-t border-gray-200 bg-white mt-8">
    <div class="max-w-5xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500">
      <p>Built by <a href="https://jakubkozera.dev" class="text-blue-600 hover:underline">Jakub Kozera</a></p>
      <div class="flex gap-6">
        <a href="https://marketplace.visualstudio.com/publishers/jakubkozera" target="_blank" rel="noopener noreferrer" class="hover:text-gray-800 transition-colors">VS Marketplace</a>
        <a href="https://open-vsx.org/user/jakubkozera" target="_blank" rel="noopener noreferrer" class="hover:text-gray-800 transition-colors">Open VSX</a>
        <a href="https://github.com/jakubkozera" target="_blank" rel="noopener noreferrer" class="hover:text-gray-800 transition-colors">GitHub</a>
      </div>
    </div>
  </footer>
</Layout>
